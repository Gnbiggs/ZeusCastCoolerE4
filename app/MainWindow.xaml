<Window x:Class="ZeusCastEnhanced.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Zeus Cast Enhanced"
        Width="1180" Height="760" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged"
        SourceInitialized="Window_SourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D111C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentBrush}">
                            <Path Data="M23,3 L11,21 L18,21 L13,37 L29,16 L21,16 Z" Fill="White" Stretch="Uniform" Margin="9" />
                        </Border>
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ZEUS CAST" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="ENHANCED • CHIONE DIGITAL" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Width="44" Height="36" Padding="0" Margin="3" Content="—" Click="Minimize_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Width="44" Height="36" Padding="0" Margin="3" Content="□" Click="Maximize_Click" />
                    <Button Background="#3A1E2A" Width="44" Height="36" Padding="0" Margin="3" Content="✕" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="DeviceStatusDot" Width="9" Height="9" Fill="#667085" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DeviceStatusText" Text="Checking CHIONE Digital…" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="PreviewValue" Text="--.-" FontFamily="Consolas" FontSize="74" FontWeight="Bold" Margin="0,12,0,-5" />
                                <TextBlock x:Name="PreviewLabel" Text="CPU TEMPERATURE  •  °C" Foreground="{StaticResource AccentBrightBrush}" FontSize="13" FontWeight="Bold" />
                                <ProgressBar x:Name="ThermalProgress" Height="5" Margin="0,22,20,0" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentBrush}" Background="#252B3B" BorderThickness="0" />
                                <TextBlock x:Name="SessionStatsText" Text="Waiting for live sensor readings…" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="138" Height="138" CornerRadius="69" BorderBrush="#3A4260" BorderThickness="2" Background="#101521" VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse Margin="12" Stroke="{StaticResource AccentBrush}" StrokeThickness="4" StrokeDashArray="1,2" Opacity="0.65" />
                                    <Path Data="M23,3 L11,21 L18,21 L13,37 L29,16 L21,16 Z" Fill="{StaticResource AccentBrightBrush}" Stretch="Uniform" Margin="44" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Display" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="Choose what appears on the cooler's four-digit screen." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,16" />

                            <TextBlock Text="MODE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                            <ComboBox x:Name="DisplayModeCombo" SelectedIndex="0" SelectionChanged="Setting_Changed">
                                <ComboBoxItem Tag="temperature" Content="CPU temperature" />
                                <ComboBoxItem Tag="fan" Content="Fan speed (RPM)" />
                                <ComboBoxItem Tag="cycle" Content="Auto-cycle temperature / fan" />
                                <ComboBoxItem Tag="custom" Content="Custom four-digit value" />
                            </ComboBox>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="UnitPanel" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="TEMPERATURE UNIT" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="CelsiusRadio" Content="Celsius" GroupName="TemperatureUnit" IsChecked="True" Checked="Setting_Changed" Margin="0,0,20,0" />
                                        <RadioButton x:Name="FahrenheitRadio" Content="Fahrenheit" GroupName="TemperatureUnit" Checked="Setting_Changed" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="CustomPanel" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="CUSTOM VALUE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TextBox x:Name="CustomValueText" Text="2026" MaxLength="4" TextChanged="Setting_Changed" PreviewTextInput="Numeric_PreviewTextInput" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <CheckBox x:Name="AlarmCheck" Content="Flash display at high temperature" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                    <TextBlock Text="The display flashes; this does not alter CPU or fan settings." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="22,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Threshold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox x:Name="ThresholdText" Width="58" Text="85" TextChanged="Setting_Changed" PreviewTextInput="Numeric_PreviewTextInput" />
                                    <TextBlock Text="°C" VerticalAlignment="Center" Margin="7,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sensors" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SensorBackendText" Text="Selecting the best available sensor backend…" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,16" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="↻" Width="38" Height="34" Padding="0" Style="{StaticResource SecondaryButton}" Click="RefreshSensors_Click" ToolTip="Restart sensor detection" />
                            </Grid>

                            <TextBlock Text="TEMPERATURE SOURCE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                            <ComboBox x:Name="TemperatureSensorCombo" DisplayMemberPath="Name" SelectionChanged="SensorSelection_Changed" />

                            <TextBlock Text="FAN SOURCE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,16,0,6" />
                            <ComboBox x:Name="FanSensorCombo" DisplayMemberPath="Name" SelectionChanged="SensorSelection_Changed" />

                            <TextBlock Text="REFRESH RATE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,16,0,6" />
                            <ComboBox x:Name="RefreshRateCombo" SelectedIndex="1" SelectionChanged="RefreshRate_Changed">
                                <ComboBoxItem Tag="500" Content="Fast • 0.5 seconds" />
                                <ComboBoxItem Tag="1000" Content="Balanced • 1 second" />
                                <ComboBoxItem Tag="2000" Content="Quiet • 2 seconds" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="App control" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="Only one app can control the cooler at a time." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,16" />
                            <Button x:Name="ConnectButton" Content="Take control of cooler" Click="ConnectButton_Click" Margin="0,0,0,10" />
                            <Button Content="Send display now" Click="SendNow_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" />
                            <Button Content="Restore original Zeus Cast (rollback)" Click="RestoreOriginal_Click" Style="{StaticResource SecondaryButton}" />
                            <CheckBox x:Name="StartWithWindowsCheck" Content="Replace original Zeus Cast at Windows sign-in" Margin="0,18,0,0" Checked="Startup_Changed" Unchecked="Startup_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0D111C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="B53C • DISPLAY-ONLY CONTROLS • PER-MONITOR DPI" Foreground="#5F687E" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
